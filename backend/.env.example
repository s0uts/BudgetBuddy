# Supabase (service role — never expose to client!)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Plaid
PLAID_CLIENT_ID=your-plaid-client-id
PLAID_SECRET=your-plaid-secret
PLAID_ENV=sandbox
# PLAID_ENV=development
# PLAID_ENV=production

# Groq (AI rule parsing)
GROQ_API_KEY=your-groq-api-key

# Twelve Data (stock prices)
TWELVE_DATA_API_KEY=your-twelve-data-key

# Encryption (for Plaid access tokens at rest)
ENCRYPTION_KEY=32-char-hex-string-here-replace-me

# Server
PORT=3001
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:8081,https://your-expo-app.com
